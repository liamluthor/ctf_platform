# ============================================================================
# SENSITIVE FILES - NEVER COMMIT THESE
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Secrets and credentials
*.key
*.pem
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials/
.secrets/

# Database files (if using SQLite locally)
*.db
*.sqlite
*.sqlite3

# ============================================================================
# BUILD OUTPUTS
# ============================================================================

# Distribution / Production builds
dist/
dist-ssr/
build/
out/
*.local

# TypeScript build info
*.tsbuildinfo
.tsbuildinfo

# ============================================================================
# DEPENDENCIES
# ============================================================================

# Node modules
node_modules/
jspm_packages/

# pnpm
.pnpm-store/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ============================================================================
# LOGS
# ============================================================================

# General logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime logs
*.pid
*.seed
*.pid.lock

# ============================================================================
# EDITOR / IDE
# ============================================================================

# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# OS SPECIFIC
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ============================================================================
# TESTING
# ============================================================================

# Coverage directories
coverage/
*.lcov
.nyc_output/
lib-cov/

# Test results
test-results/
playwright-report/
.jest/

# ============================================================================
# TEMPORARY FILES
# ============================================================================

# Temporary folders
tmp/
temp/
.tmp/
.cache/

# File uploads (user-generated content)
uploads/*
!uploads/.gitkeep

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Drizzle Kit
.drizzle/

# Vite
.vite/
vite.config.*.timestamp-*

# Turbo
.turbo/

# Next.js (if ever needed)
.next/

# Vercel
.vercel

# ============================================================================
# MISC
# ============================================================================

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Lock files (keep package-lock.json but ignore others)
# Uncomment the ones you don't use:
# yarn.lock
# pnpm-lock.yaml

# Backup files
*.bak
*.backup
*.old
*.orig

# Archive files (unless intentional)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
