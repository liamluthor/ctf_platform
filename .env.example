# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ctf

# Session
SESSION_SECRET=your-very-secure-secret-key-at-least-32-characters

# Admin Bootstrap (used to create initial admin on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=securepassword123

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Application
PORT=5000
NODE_ENV=development

# Platform Branding (optional - database settings override these)
PLATFORM_NAME=CTF Platform
PLATFORM_TAGLINE=Test Your Cybersecurity Skills
PRIMARY_COLOR=345 80% 35%

# Container Management (Docker)
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_PORT_RANGE_MIN=30000
CONTAINER_PORT_RANGE_MAX=40000

# Email & Access Configuration
# BASE_URL is used for email links (password reset, verification) and container access URLs
BASE_URL=http://localhost:5000

# Email Configuration
# Provider: "smtp" or "ses"
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@ctf.local
EMAIL_FROM_NAME=CTF Platform

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# AWS SES Configuration (when EMAIL_PROVIDER=ses)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Note: If running on EC2 with IAM role, you can omit AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
