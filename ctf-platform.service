[Unit]
Description=CTF Platform - Capture The Flag Competition Platform
Documentation=https://github.com/liamluthor/ctf_platform
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/ctfd/raptorsCTF

# Environment
Environment=NODE_ENV=production
Environment=PORT=5001
EnvironmentFile=/srv/ctfd/raptorsCTF/.env

# Start command
ExecStart=/usr/bin/node /srv/ctfd/raptorsCTF/dist/index.cjs

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=5min
StartLimitBurst=5

# Security hardening (relaxed for compatibility)
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/srv/ctfd/raptorsCTF

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ctf-platform

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
